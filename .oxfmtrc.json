{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "ignorePatterns": [
    "build/**",
    "docs/**",
    "coverage/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "src/tests/codegen/fixtures/openapi-3.1.0.json",
    "CHANGELOG.md",
    "LICENSE"
  ]
}

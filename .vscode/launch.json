{
  "version": "0.2.0",
  "configurations": [
    // Debugs the *.spec.ts file open in the editor. Vitest picks the project from the file's
    // path. The module-imports specs load build/, so run `pnpm build` before debugging them.
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Active Spec",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}

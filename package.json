{
  "name": "permitio",
  "version": "2.7.5",
  "description": "Node.js client library for the Permit.io full-stack permissions platform",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/permitio/permit-node.git"
  },
  "files": [
    "build/**/*.d.ts",
    "build/index.js",
    "build/index.mjs",
    "!build/tests/**",
    "CHANGELOG.md",
    "LICENSE",
    "MIGRATION.md",
    "README.md",
    "skills/permit-node-3-migration/SKILL.md",
    "skills/permit-node-3-migration/references/**",
    "skills/permit-node-3-migration/scripts/**",
    "skills/permit-node-3-migration/package.json",
    "skills/permit-node-3-migration/compiler-lock.yaml",
    "skills/permit-node-3-migration/pnpm-workspace.yaml"
  ],
  "type": "commonjs",
  "main": "build/index.js",
  "module": "build/index.mjs",
  "typings": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "node scripts/build.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir build && node scripts/declarations.mjs",
    "lint": "pnpm run lint:oxlint && pnpm run lint:format && pnpm run lint:types",
    "lint:types": "tsc -p tsconfig.test.json",
    "fix": "oxlint --fix . && oxfmt --write .",
    "test": "pnpm run build && node scripts/run-tests.mjs offline",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:module-imports": "pnpm run build && node scripts/run-tests.mjs module-imports",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "watch": "vitest --project unit",
    "coverage": "node scripts/run-tests.mjs coverage",
    "docs": "node tools/compiler/docs.mjs",
    "docs:watch": "node tools/compiler/docs.mjs --watch",
    "generate-openapi-client": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "check:codegen": "node scripts/check-codegen.mjs",
    "test:codegen": "pnpm run build && node scripts/run-tests.mjs codegen",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:format": "oxfmt --check .",
    "verify": "pnpm exec prek run --config .pre-commit-config.yaml --all-files && pnpm run build && node scripts/run-tests.mjs verify && pnpm run check:api-contracts",
    "hooks:install": "node scripts/hooks.mjs",
    "normalize:openapi": "node scripts/normalize-openapi.mjs && oxfmt --write src/openapi",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "check:api-contracts": "node scripts/check-api-contracts.mjs",
    "check:api-drift": "node scripts/check-api-contracts.mjs --live",
    "check:release-evidence": "node scripts/check-release-evidence.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "lodash": "4.18.1",
    "pino": "8.21.0",
    "pino-pretty": "10.3.1"
  },
  "devDependencies": {
    "@j178/prek": "0.5.4",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@permitio/compiler-tools": "workspace:*",
    "@types/lodash": "4.17.25",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "semver": "7.8.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
